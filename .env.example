# HearMind Docker 部署环境变量
# 复制为 .env 后修改：cp .env.example .env

# MySQL root 密码（至少 8 位，compose 内 mysql/backend 共用）
MYSQL_ROOT_PASSWORD=ChangeMe_Strong_Password_123

# DashScope API Key（二选一：此处填写，或写入 config/dashscope.key）
DASHSCOPE_API_KEY=

# JWT 签名密钥（生产环境务必修改，至少 32 字符）
AUTH_JWT_SECRET=hearmind-jwt-secret-change-in-production-32chars

# 对外 HTTP 端口（默认 80，若被占用可改为 8080）
HTTP_PORT=80
